# Python caches: a leftover service_catalog/pages/__pycache__ folder would make Streamlit treat
# the portal as a folder-pages app and show "Page not found" for the first direct link.
**/__pycache__
**/*.pyc

# Not used by the image build.
.git
.venv
.dev
docs/node_modules
specs

# The image builds use the repository root as context. The portal image copies only
# pyproject.toml, uv.lock and service_catalog/; the Infrahub image copies the same
# files and README.md. Keep the context small.
.github
docs
.env
.mypy_cache
.pytest_cache
.ruff_cache
.specify
.claude
.agents
ansible
bootstrap
checks
data
dev
files
generators
schemas
scripts
semaphore
templates
tests
transforms
